# Default: auto-detect text and normalise to LF in the index.
# Everything below only overrides the *working tree* checkout behaviour.
* text=auto

# ---------------------------------------------------------------------------
# Source: TypeScript, Astro and the package's own .mjs entry points.
# No eol= means each dev's core.autocrlf / core.eol decides; .editorconfig is
# the authority, and `end_of_line = lf` there matches what the tools write.
# ---------------------------------------------------------------------------
*.mjs       text
*.js        text
*.cjs       text
*.ts        text
*.mts       text
*.cts       text
*.jsx       text
*.tsx       text
*.astro     text diff=html
*.html      text diff=html

# ---------------------------------------------------------------------------
# Data, config and docs
# ---------------------------------------------------------------------------
*.json      text
*.xml       text
*.yml       text
*.yaml      text
*.toml      text
*.md        text diff=markdown
*.mdx       text diff=markdown
*.svg       text
*.css       text
*.scss      text
*.langium   text
*.editorconfig text
.gitattributes text
.gitignore  text

# ---------------------------------------------------------------------------
# Generated grammar artefacts
# `snapshot.test.ts` re-derives these and compares, so the bytes matter: a
# CRLF checkout on Windows would fail the test without eol=lf here.
# ---------------------------------------------------------------------------
src/grammar/likec4.tmLanguage.json  text eol=lf
src/grammar/like-c4.langium         text eol=lf

# ---------------------------------------------------------------------------
# Scripts -- these MUST be pinned regardless of platform.
# cmd.exe misparses LF in multi-line blocks and labels; sh needs LF.
# ---------------------------------------------------------------------------
*.sh        text eol=lf
*.bash      text eol=lf
*.zsh       text eol=lf
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=lf
*.psm1      text eol=lf
*.psd1      text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf
justfile    text eol=lf
Makefile    text eol=lf

# Patches carry their own endings -- never touch them.
*.patch     -text

# ---------------------------------------------------------------------------
# Binary
# ---------------------------------------------------------------------------
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.mp4       binary
*.zip       binary
*.gz        binary
*.7z        binary
*.tar       binary
*.exe       binary
*.dll       binary
*.pdb       binary
*.obj       binary
*.vsix      binary
*.nupkg     binary
*.snupkg    binary
*.snk       binary
*.pfx       binary
*.lockb     binary
*.woff      binary
*.woff2     binary

# ---------------------------------------------------------------------------
# Keep repo scaffolding out of `git archive` / source packages
# ---------------------------------------------------------------------------
.gitattributes  export-ignore
.gitignore      export-ignore
.github/        export-ignore
