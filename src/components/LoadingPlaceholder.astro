---
interface Props {
	label: string;
}

const { label } = Astro.props;
---

<div class="likec4-loading" role="status" aria-live="polite" aria-busy="true">
	<div class="likec4-loading__label">{label}</div>

	<div class="likec4-loading__lines" aria-hidden="true">
		<div class="likec4-loading__line" style="width: 75%"></div>
		<div class="likec4-loading__line" style="width: 83.333%"></div>
		<div class="likec4-loading__line" style="width: 66.667%"></div>
	</div>
</div>

<style>
	/* See DiagramShell for the token contract. */
	.likec4-loading {
		--_likec4-border: var(--likec4-border, var(--sl-color-gray-5, rgba(128, 128, 128, 0.35)));
		--_likec4-surface: var(--likec4-surface, var(--sl-color-bg, transparent));
		--_likec4-text-muted: var(--likec4-text-muted, var(--sl-color-gray-2, rgba(128, 128, 128, 0.95)));
		--_likec4-skeleton: var(--likec4-skeleton, var(--sl-color-gray-6, rgba(128, 128, 128, 0.18)));

		border: 1px dashed var(--_likec4-border);
		border-radius: 0.5rem;
		background: var(--_likec4-surface);
		padding: 1.25rem;
	}

	.likec4-loading__label {
		margin-bottom: 1rem;
		font-size: 0.875rem;
		line-height: 1.25rem;
		font-weight: 500;
		color: var(--_likec4-text-muted);
	}

	.likec4-loading__lines {
		display: grid;
		gap: 0.5rem;
	}

	.likec4-loading__line {
		height: 1rem;
		border-radius: 0.25rem;
		background: var(--_likec4-skeleton);
		animation: likec4-pulse 1.6s ease-in-out infinite;
	}

	@keyframes likec4-pulse {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.45;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.likec4-loading__line {
			animation: none;
		}
	}
</style>
