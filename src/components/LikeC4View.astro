---
// LikeC4View.astro
// path: src/components/LikeC4View.astro
// Docs-facing wrapper around the LikeC4 React island. Use this from .mdx pages:
//   import LikeC4View from '@purview-dev/astroc4/components/LikeC4View.astro';
//   <LikeC4View viewId="index" />
//   <LikeC4View viewId="edge" projectId="my-project" height={560} />

import DiagramFrame from './DiagramFrame.astro';
import DiagramShell from './DiagramShell.astro';
import LikeC4ProjectView from './LikeC4ProjectView';
import LoadingPlaceholder from './LoadingPlaceholder.astro';
import { getIslandLabels, getTranslator } from './labels';

interface Props {
	/** View id inside the selected LikeC4 project. */
	viewId: string;
	/** Optional project id (maps to `likec4:react/<projectId>`). */
	projectId?: string;
	/** Shell heading. */
	title?: string;
	description?: string;
	/** Rendered height in pixels. */
	height?: number;
	collapsible?: boolean;
	defaultOpen?: boolean;
}

// Starlight augments `App.Locals` with `t`; a plain Astro page has no such
// property (and an empty `Locals` interface, so naming it would not type-check),
// which is why this is read as `unknown` and `getTranslator` falls back to
// English when it is absent.
const t = getTranslator((Astro.locals as { t?: unknown }).t);
const labels = getIslandLabels(t, 'likec4.view.loading');

const {
	viewId,
	projectId,
	title = t('likec4.view.title'),
	description = t('likec4.view.description'),
	height = 480,
	collapsible = true,
	defaultOpen = true,
} = Astro.props;
---

<DiagramShell
	title={title}
	description={description}
	hint={t('likec4.view.hint')}
	collapsible={collapsible}
	defaultOpen={defaultOpen}
>
	<div class="likec4-badge">
		<span aria-hidden="true">🖱️</span>
		<span>{t('likec4.view.badge')}</span>
	</div>

	<DiagramFrame height={height}>
		<LikeC4ProjectView viewId={viewId} projectId={projectId} labels={labels} client:only="react">
			{
				/* `slot="fallback"` is required: default-slot children of a `client:only`
			    island are parked in an inert <template> and never painted. */
			}
			<LoadingPlaceholder slot="fallback" label={labels.loading} />
		</LikeC4ProjectView>
	</DiagramFrame>
</DiagramShell>

<style>
	/* Same token contract as DiagramShell (see the note there). */
	.likec4-badge {
		--likec4-border: var(--sl-color-gray-5, rgba(128, 128, 128, 0.35));
		--likec4-surface: var(--sl-color-bg, transparent);
		--likec4-text-muted: var(--sl-color-gray-2, rgba(128, 128, 128, 0.95));

		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.75rem;
		border: 1px solid var(--likec4-border);
		border-radius: 9999px;
		background: var(--likec4-surface);
		padding: 0.25rem 0.75rem;
		font-size: 0.75rem;
		line-height: 1rem;
		color: var(--likec4-text-muted);
	}
</style>
