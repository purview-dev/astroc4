---
interface Props {
	title: string;
	description?: string;
	hint?: string;
	collapsible?: boolean;
	defaultOpen?: boolean;
}

const { title, description, hint, collapsible = true, defaultOpen = true } = Astro.props;
---

<section class="not-content likec4-shell">
	{
		collapsible ? (
			<details open={defaultOpen}>
				<summary class="likec4-shell__header">
					<div class="likec4-shell__heading">
						<h3 class="likec4-shell__title">{title}</h3>
						{description && <p class="likec4-shell__description">{description}</p>}
						{hint && <p class="likec4-shell__hint">{hint}</p>}
					</div>
				</summary>

				<div class="likec4-shell__body">
					<slot />
				</div>
			</details>
		) : (
			<>
				<header class="likec4-shell__header">
					<h3 class="likec4-shell__title likec4-shell__title--block">{title}</h3>
					{description && <p class="likec4-shell__description">{description}</p>}
					{hint && <p class="likec4-shell__hint">{hint}</p>}
				</header>

				<div class="likec4-shell__body">
					<slot />
				</div>
			</>
		)
	}
</section>

<style>
	/* Token contract: a site sets the public `--likec4-*` tokens on any ancestor;
	   components never declare them, only read them into private `--_likec4-*`
	   names, so an override inherits instead of fighting scoped specificity.
	   Unset, they fall back to Starlight's palette, then to scheme-neutral
	   greys and `inherit` (an undefined `var()` with no fallback is invalid). */
	.likec4-shell {
		--_likec4-border: var(--likec4-border, var(--sl-color-gray-5, rgba(128, 128, 128, 0.35)));
		--_likec4-surface: var(--likec4-surface, var(--sl-color-bg, transparent));
		--_likec4-surface-alt: var(--likec4-surface-alt, var(--sl-color-bg-nav, rgba(128, 128, 128, 0.06)));
		--_likec4-text: var(--likec4-text, var(--sl-color-white, inherit));
		--_likec4-text-muted: var(--likec4-text-muted, var(--sl-color-gray-2, rgba(128, 128, 128, 0.95)));
		--_likec4-accent: var(--likec4-accent, var(--sl-color-text-accent, inherit));

		margin-block: 1em;
		overflow: hidden;
		border: 1px solid var(--_likec4-border);
		border-radius: 0.75rem;
		background: var(--_likec4-surface-alt);
	}

	.likec4-shell__header {
		border-bottom: 1px solid var(--_likec4-border);
		background: var(--_likec4-surface);
		padding: 1em 1.25rem;
		line-height: 1.4;
	}

	summary.likec4-shell__header {
		cursor: pointer;
	}

	.likec4-shell__heading {
		display: inline-block;
		vertical-align: top;
	}

	.likec4-shell__title {
		display: inline;
		margin: 0;
		font-size: 1rem;
		line-height: 1.5rem;
		font-weight: 600;
		color: var(--_likec4-text);
	}

	.likec4-shell__title--block {
		display: block;
	}

	.likec4-shell__description {
		margin: 0.25rem 0 0;
		font-size: 0.875rem;
		line-height: 1.25rem;
		color: var(--_likec4-text-muted);
	}

	.likec4-shell__hint {
		margin: 0.5rem 0 0;
		font-size: 0.75rem;
		line-height: 1rem;
		font-weight: 500;
		color: var(--_likec4-accent);
	}

	.likec4-shell__body {
		padding: 1em 1.25rem;
	}

	@media (min-width: 48rem) {
		.likec4-shell__header,
		.likec4-shell__body {
			padding-inline: 1.5rem;
		}
	}
</style>
