---
// DiagramFrame.astro
// path: src/components/DiagramFrame.astro
// The sized container a LikeC4 island renders into. Shared by <LikeC4View>
// (project model) and <LikeC4Fence> (inline DSL) so both size identically.

interface Props {
	/** Rendered height in pixels. */
	height?: number;
}

const { height = 480 } = Astro.props;
---

<div class="likec4-frame" style={`--likec4-height: ${height}px;`}>
	<slot />
</div>

<style>
	/* LikeC4's renderer measures its container, so it needs a concrete height
	   rather than collapsing to the intrinsic size of an absolutely-positioned
	   canvas. The per-instance value arrives as an inline custom property. */
	/* Same token contract as DiagramShell: Starlight's palette when present,
	   scheme-neutral fallbacks when not (see the note there). */
	.likec4-frame {
		--likec4-border: var(--sl-color-gray-5, rgba(128, 128, 128, 0.35));
		--likec4-surface: var(--sl-color-bg, transparent);
		--likec4-danger: var(--sl-color-red, #c0392b);
		--likec4-danger-soft: var(--sl-color-red-low, rgba(192, 57, 43, 0.12));
		--likec4-danger-text: var(--sl-color-red-high, #8b1d1d);

		min-height: var(--likec4-height);
	}

	/* :global() because the markup below this point is created at runtime by
	   LikeC4 (or by the React error boundary) and so carries no scope hash. */
	.likec4-frame :global(.likec4-view),
	.likec4-frame :global([data-likec4-view]) {
		width: 100%;
		height: var(--likec4-height);
		overflow: hidden;
		border-radius: 0.5rem;
	}

	.likec4-frame :global(.likec4-error) {
		border: 1px solid var(--likec4-danger);
		border-radius: 0.5rem;
		background: var(--likec4-danger-soft);
		padding: 1rem;
		font-size: 0.875rem;
		line-height: 1.25rem;
		color: var(--likec4-danger-text);
	}

	.likec4-frame :global(.likec4-error p) {
		margin: 0.25rem 0 0;
	}

	.likec4-frame :global(.likec4-error .likec4-error__title) {
		margin: 0;
		font-weight: 600;
	}

	.likec4-frame :global(.likec4-error__retry) {
		margin-top: 0.75rem;
		border: 1px solid var(--likec4-danger);
		border-radius: 0.375rem;
		background: transparent;
		padding: 0.375rem 0.75rem;
		font: inherit;
		font-size: 0.75rem;
		font-weight: 500;
		color: inherit;
		cursor: pointer;
	}

	.likec4-frame :global(.likec4-error__retry:hover) {
		background: var(--likec4-surface);
	}
</style>
