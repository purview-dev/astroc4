---
interface Props {
	height?: number;
}

const { height = 480 } = Astro.props;
---

<div class="likec4-frame" style={`--likec4-height: ${height}px;`}>
	<slot />
</div>

<style>
	/* LikeC4's renderer measures its container, so it needs a concrete height.
	   See DiagramShell for the token contract. */
	.likec4-frame {
		--_likec4-surface: var(--likec4-surface, var(--sl-color-bg, transparent));
		--_likec4-danger: var(--likec4-danger, var(--sl-color-red, #c0392b));
		--_likec4-danger-soft: var(--likec4-danger-soft, var(--sl-color-red-low, rgba(192, 57, 43, 0.12)));
		--_likec4-danger-text: var(--likec4-danger-text, var(--sl-color-red-high, #8b1d1d));

		min-height: var(--likec4-height);
	}

	/* :global() because LikeC4 and the error boundary create this markup at
	   runtime, without a scope hash. */
	.likec4-frame :global(.likec4-view),
	.likec4-frame :global([data-likec4-view]) {
		width: 100%;
		height: var(--likec4-height);
		overflow: hidden;
		border-radius: 0.5rem;
	}

	.likec4-frame :global(.likec4-error) {
		border: 1px solid var(--_likec4-danger);
		border-radius: 0.5rem;
		background: var(--_likec4-danger-soft);
		padding: 1rem;
		font-size: 0.875rem;
		line-height: 1.25rem;
		color: var(--_likec4-danger-text);
	}

	.likec4-frame :global(.likec4-error p) {
		margin: 0.25rem 0 0;
	}

	.likec4-frame :global(.likec4-error .likec4-error__title) {
		margin: 0;
		font-weight: 600;
	}

	.likec4-frame :global(.likec4-error__retry) {
		margin-top: 0.75rem;
		border: 1px solid var(--_likec4-danger);
		border-radius: 0.375rem;
		background: transparent;
		padding: 0.375rem 0.75rem;
		font: inherit;
		font-size: 0.75rem;
		font-weight: 500;
		color: inherit;
		cursor: pointer;
	}

	.likec4-frame :global(.likec4-error__retry:hover) {
		background: var(--_likec4-surface);
	}
</style>
