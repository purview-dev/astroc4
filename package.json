{
  "name": "astroc4",
  "version": "1.0.0-prerelease.1",
  "description": "Interactive LikeC4 architecture diagrams for Astro and Starlight: <LikeC4View>, ```likec4 fences, and LikeC4 syntax highlighting derived from the live Langium grammar.",
  "license": "MIT",
  "author": {
    "name": "Kieron Lanning",
    "url": "https://kieronlanning.dev/"
  },
  "homepage": "https://purview.dev/projects/astroc4/",
  "bugs": {
    "url": "https://github.com/purview-dev/astroc4/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/purview-dev/astroc4.git"
  },
  "keywords": [
    "likec4",
    "c4-model",
    "architecture-as-code",
    "architecture-diagrams",
    "diagrams",
    "astro",
    "astro-integration",
    "starlight",
    "starlight-plugin",
    "expressive-code",
    "shiki",
    "syntax-highlighting",
    "documentation"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.mjs",
    "./expressive-code": "./src/expressive-code.mjs",
    "./grammar/likec4.tmLanguage.json": "./src/grammar/likec4.tmLanguage.json",
    "./components/LikeC4View.astro": "./src/components/LikeC4View.astro",
    "./components/LikeC4Fence.astro": "./src/components/LikeC4Fence.astro"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "!src/**/__fixtures__"
  ],
  "scripts": {
    "dev": "cd playground && astro dev",
    "build": "cd playground && astro build",
    "preview": "cd playground && astro preview",
    "check": "cd playground && astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:network": "ASTROC4_NETWORK=1 vitest run src/grammar/__tests__/network.test.ts",
    "test:site": "bun scripts/test-site.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "grammar:sync": "bun scripts/sync-grammar.mjs",
    "grammar:check": "bun scripts/sync-grammar.mjs --check",
    "likec4:validate": "likec4 validate playground/src/likec4"
  },
  "peerDependencies": {
    "@astrojs/markdown-satteri": ">=0.4.6",
    "@astrojs/react": ">=7.1.2",
    "@astrojs/starlight": ">=0.42.8",
    "@likec4/core": ">=1.59.4",
    "astro": ">=7.4.4",
    "likec4": ">=1.59.4",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "shiki": ">=1.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/react": "^7.1.2",
    "@astrojs/starlight": "^0.42.8",
    "@likec4/core": "^1.59.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.4",
    "likec4": "^1.59.4",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.3",
    "shiki": "^4.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.4.4",
  "publishConfig": {
    "access": "public"
  }
}

