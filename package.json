{
  "name": "astroc4",
  "version": "0.1.0",
  "private": true,
  "description": "Starlight plugin for interactive LikeC4 architecture diagrams: <LikeC4View>, ```likec4 fences, syntax highlighting and translatable UI.",
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    ".": "./src/index.mjs",
    "./expressive-code": "./src/expressive-code.mjs",
    "./grammar/likec4.tmLanguage.json": "./src/grammar/likec4.tmLanguage.json",
    "./components/LikeC4View.astro": "./src/components/LikeC4View.astro",
    "./components/LikeC4Fence.astro": "./src/components/LikeC4Fence.astro"
  },
  "files": [
    "src",
    "!src/**/__tests__"
  ],
  "scripts": {
    "dev": "cd playground && astro dev",
    "build": "cd playground && astro build",
    "preview": "cd playground && astro preview",
    "check": "cd playground && astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke.mjs",
    "likec4:validate": "likec4 validate playground/src/likec4"
  },
  "peerDependencies": {
    "@astrojs/markdown-satteri": ">=0.4.6",
    "@astrojs/react": ">=7.1.2",
    "@astrojs/starlight": ">=0.42.8",
    "@likec4/core": ">=1.59.4",
    "astro": ">=7.4.4",
    "likec4": ">=1.59.4",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/react": "^7.1.2",
    "@astrojs/starlight": "^0.42.8",
    "@likec4/core": "^1.59.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.4",
    "likec4": "^1.59.4",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.3",
    "shiki": "^4.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
