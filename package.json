{
  "name": "@purview-dev/astroc4",
  "version": "1.0.0-prerelease.3",
  "description": "Interactive LikeC4 architecture diagrams for Astro and Starlight: <LikeC4View>, ```likec4 fences, and LikeC4 syntax highlighting derived from the live Langium grammar.",
  "license": "MIT",
  "author": {
    "name": "Kieron Lanning",
    "url": "https://kieronlanning.dev/"
  },
  "homepage": "https://purview.dev/projects/astroc4/",
  "bugs": {
    "url": "https://github.com/purview-dev/astroc4/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/purview-dev/astroc4.git"
  },
  "keywords": [
    "likec4",
    "c4-model",
    "architecture-as-code",
    "architecture-diagrams",
    "diagrams",
    "astro",
    "astro-integration",
    "starlight",
    "starlight-plugin",
    "expressive-code",
    "shiki",
    "syntax-highlighting",
    "documentation"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./expressive-code": {
      "types": "./dist/expressive-code.d.ts",
      "import": "./dist/expressive-code.js"
    },
    "./grammar/likec4.tmLanguage.json": "./dist/likec4.tmLanguage.json",
    "./components/LikeC4View.astro": "./src/components/LikeC4View.astro",
    "./components/LikeC4Fence.astro": "./src/components/LikeC4Fence.astro"
  },
  "files": [
    "dist",
    "src/components",
    "!src/components/__tests__",
    "src/translations.ts"
  ],
  "scripts": {
    "build:lib": "bun scripts/build.ts",
    "dev": "bun run build:lib && cd playground && astro dev",
    "build": "bun run build:lib && cd playground && astro build",
    "preview": "cd playground && astro preview",
    "check": "bun run build:lib && cd playground && astro check && cd .. && bunx tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:network": "ASTROC4_NETWORK=1 vitest run src/grammar/__tests__/network.test.ts",
    "test:site": "bun run build:lib && bun scripts/test-site.ts",
    "test:smoke": "bun scripts/smoke.ts",
    "grammar:sync": "bun scripts/sync-grammar.ts",
    "grammar:check": "bun scripts/sync-grammar.ts --check",
    "likec4:validate": "likec4 validate playground/src/likec4"
  },
  "peerDependencies": {
    "@astrojs/markdown-satteri": ">=0.4.6",
    "@astrojs/react": ">=7.1.2",
    "@astrojs/starlight": ">=0.42.8",
    "@likec4/core": ">=1.59.4",
    "astro": ">=7.4.4",
    "likec4": ">=1.59.4",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "shiki": ">=1.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/react": "^7.1.2",
    "@astrojs/starlight": "^0.42.8",
    "@likec4/core": "^1.59.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.4",
    "likec4": "^1.59.4",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.3",
    "shiki": "^4.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.4.4",
  "publishConfig": {
    "access": "public"
  }
}

