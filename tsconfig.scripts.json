{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"declaration": false,
		"emitDeclarationOnly": false,
		"rootDir": ".",
		"allowJs": true,
		// `scripts/smoke.ts` evaluates code inside the page, so it needs DOM types.
		"lib": ["ES2023", "DOM"]
	},
	"include": ["scripts/**/*.ts", "vitest.config.ts"]
}
