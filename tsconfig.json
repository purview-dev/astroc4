// Emits the `.d.ts` files Bun cannot. `astro check` type-checks src through
// `playground/tsconfig.json`. Relative imports use `.ts`; the build rewrites
// them to `.js` in the emitted declarations, which sit next to `.js` bundles.
{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"allowImportingTsExtensions": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"outDir": "dist",
		"types": ["node"],
		"rootDir": "src"
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/**/__tests__", "src/components/**", "src/types.d.ts"]
}
